### Units: List (all, no pagination)
GET {{baseUrl}}/units?page=0&q=sales
Authorization: Bearer {{login.response.body.$.data.token}}

### Units: List (paged)
GET {{baseUrl}}/units?page=1&limit=10&q=sales
Authorization: Bearer {{login.response.body.$.data.token}}

### Units: Create
# @name createUnit
POST {{baseUrl}}/units
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.data.token}}

{
  "subdomain": "sales",
  "name": "Sales Department",
  "description": "Handles sales operations",
  "logo_url": "https://example.com/logo.png",
  "service_packages": [
    {
      "service_package_id": "{{createServicePackage.response.body.$.data.id}}",
      "start_at": "2025-01-01T00:00:00Z",
      "end_at": "2030-01-01T00:00:00Z"
    }
  ],
  "admin_user": {
    "username": "admin",
    "password": "admin",
    "name": "Sales Admin",
    "email": "sales.admin@example.com"
  }
}
 

### Units: Get Detail
GET {{baseUrl}}/units?id={{createUnit.response.body.$.data.id}}
Authorization: Bearer {{login.response.body.$.data.token}}

### Units: Update
PUT {{baseUrl}}/units
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.data.token}}

{
  "id": "{{createUnit.response.body.$.data.id}}",
  "subdomain": "sales-new",
  "name": "Sales & Marketing",
  "description": "Merged department",
  "logo_url": "https://example.com/newlogo.png",
  "service_package_ids": ["{{createServicePackage.response.body.$.data.id}}"]
}

### Units: Delete
DELETE {{baseUrl}}/units?id={{createUnit.response.body.$.data.id}}
Authorization: Bearer {{login.response.body.$.data.token}}


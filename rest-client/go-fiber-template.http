### Health
GET {{baseUrl}}/health

### Auth: Login SuperAdmin
# @name login
POST {{baseUrl}}/auth/admin
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

### Auth: Login Unit User (requires subdomain)
# @name unitLogin
POST {{baseUrl}}/auth/unit
Content-Type: application/json

{
  "subdomain": "{{unitSubdomain}}",
  "username": "{{unitUsername}}",
  "password": "{{unitPassword}}"
}

### Unit Users: List (admin-only)
GET {{baseUrl}}/unit_users?page=0&q=
Authorization: Bearer {{unitLogin.response.body.$.data.token}}

### Unit Users: Create (admin-only)
# @name createUnitUser
POST {{baseUrl}}/unit_users
Content-Type: application/json
Authorization: Bearer {{unitLogin.response.body.$.data.token}}

{
  "username": "member1",
  "password": "Member@123",
  "name": "Member One",
  "email": "member1@example.com",
  "is_admin": false,
  "role_group_ids": ["{{createUnitRoleGroup.response.body.$.data.id}}"]
}

### Unit Users: Get Detail (admin-only)
GET {{baseUrl}}/unit_users?id={{createUnitUser.response.body.$.data.id}}
Authorization: Bearer {{unitLogin.response.body.$.data.token}}

### Unit Users: Update (admin-only)
PUT {{baseUrl}}/unit_users
Content-Type: application/json
Authorization: Bearer {{unitLogin.response.body.$.data.token}}

{
  "id": "{{createUnitUser.response.body.$.data.id}}",
  "name": "Member One Updated",
  "email": "member1_new@example.com",
  "is_admin": false,
  "role_group_ids": ["{{createUnitRoleGroup.response.body.$.data.id}}"]
}

### Unit Users: Delete (admin-only)
DELETE {{baseUrl}}/unit_users?id={{createUnitUser.response.body.$.data.id}}
Authorization: Bearer {{unitLogin.response.body.$.data.token}}


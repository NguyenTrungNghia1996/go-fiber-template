### Uploads: Get Presigned Upload URL
# @name presign
PUT {{baseUrl}}/uploads/presigned_url
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.data.token}}

{
  "filename": "example.jpg",
  "filetype": "image/jpeg"
}

### Uploads: Delete File
DELETE {{baseUrl}}/uploads/file?id={{presign.response.body.$.data.key}}
Authorization: Bearer {{login.response.body.$.data.token}}

### Unit Uploads: Get Presigned Upload URL
# @name unitPresign
PUT {{baseUrl}}/unit_uploads/presigned_url
Content-Type: application/json
Authorization: Bearer {{unitLogin.response.body.$.data.token}}

{
  "filename": "unit-example.jpg",
  "filetype": "image/jpeg"
}

### Unit Uploads: List Files (paged)
# @name unitListFiles
GET {{baseUrl}}/unit_uploads?page=1&limit=10&q=
Authorization: Bearer {{unitLogin.response.body.$.data.token}}

### Unit Uploads: Get File Detail
GET {{baseUrl}}/unit_uploads?id={{unitListFiles.response.body.$.data.items[0].key}}
Authorization: Bearer {{unitLogin.response.body.$.data.token}}

### Unit Uploads: Delete File
DELETE {{baseUrl}}/unit_uploads/file?id={{unitPresign.response.body.$.data.key}}
Authorization: Bearer {{unitLogin.response.body.$.data.token}}
